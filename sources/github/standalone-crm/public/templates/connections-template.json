      "client_secret": "PASTE-CLIENT-SECRET"
    },
    {
      "name": "Microsoft sign-in",
      "type": "oauth",
      "provider": "microsoft",
      "site": "https://entra.microsoft.com",
      "client_id": "PASTE-APPLICATION-CLIENT-ID",
      "client_secret": "PASTE-CLIENT-SECRET-VALUE",
      "tenant": "common"
    },
    {
      "name": "GitHub sign-in",
      "type": "oauth",
      "provider": "github",
      "site": "https://github.com/settings/developers",
      "client_id": "PASTE-CLIENT-ID",
      "client_secret": "PASTE-CLIENT-SECRET"
    },
    {
      "name": "Vercel sign-in",
      "type": "oauth",
      "provider": "vercel",
      "site": "https://vercel.com/account",
      "client_id": "PASTE-CLIENT-ID",
      "client_secret": "PASTE-CLIENT-SECRET"
    },
    {
      "name": "Apple sign-in (paid)",
      "type": "oauth",
      "provider": "apple",
